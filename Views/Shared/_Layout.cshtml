<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content="Convert PNG, JPG, JPEG, GIF and WebP images into ANSI, ASCII, Emoji, HTML, SVG, LaTeX and RTF text art. Free online converter and API." />

    <meta name="keywords" content="png to html, image to html, image to ascii, ansi art generator, ascii art generator, image to ansi, image to svg, image to latex, image to emoji, image to rtf, text art converter" />

    <meta name="author" content="netscii" />
    <meta name="robots" content="index,follow,max-image-preview:large" />

    <link rel="canonical" href="https://netscii.runasp.net/" />

    <meta property="og:title" content="netscii - Image to Text Art Converter" />
    <meta property="og:description" content="Convert images into ANSI, ASCII, Emoji, HTML, SVG, LaTeX and RTF text art." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://netscii.runasp.net/" />
    <meta property="og:site_name" content="netscii" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="netscii - Image to Text Art Converter" />
    <meta name="twitter:description" content="Convert images into ANSI, ASCII, Emoji, HTML, SVG, LaTeX and RTF text art." />

    <meta name="google-site-verification" content="oPoAleo4kqxaFYGsoyRnv0MQopuCAesar6rr1lUjIzM" />

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WebApplication",
          "name": "netscii",
          "url": "https://netscii.runasp.net/",
          "applicationCategory": "UtilityApplication",
          "operatingSystem": "Any",
          "description": "Convert images into ANSI, ASCII, Emoji, HTML, SVG, LaTeX and RTF text art.",
        }
    </script>

    <title>@ViewData["Title"] - netscii</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-body-tertiary border-bottom shadow-sm mb-4" aria-label="Primary navigation">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">netscii</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNavbar" aria-controls="primaryNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="primaryNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        @{
                            var currentFormat = ViewContext.RouteData.Values["format"]?.ToString()?.ToLowerInvariant();
                        }

                        <li class="nav-item">
                            <a class="nav-link @(string.IsNullOrEmpty(currentFormat) ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @foreach (var format in netscii.Constants.ConversionConstants.Formats)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentFormat == format ? "active" : "")"
                                   asp-controller="Conversion"
                                   asp-action="Index"
                                   asp-route-format="@format">.@format</a>
                            </li>
                        }
                    </ul>
                    <button id="themeToggle" class="btn btn-outline-secondary" type="button" aria-label="Toggle dark/light theme">
                        🌙 Dark
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <main class="container pb-5 flex-grow-1" role="main">
        @RenderBody()
    </main>

    <footer class="bg-body-tertiary border-top text-center py-3 mt-auto">
        <div class="container">
            <nav aria-label="Footer navigation">
                <ul class="list-inline d-flex justify-content-center">
                    <li class="list-inline-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="list-inline-item"><a href="/swagger/index.html" target="_blank">API</a></li>
                    <li class="list-inline-item"><a asp-controller="ConversionLog" asp-action="Index">Log</a></li>
                    <li class="list-inline-item"><a href="https://github.com/david-soliar/netscii" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                </ul>
            </nav>
            <small class="text-muted d-block text-center mt-2">
                &#9825; netscii
            </small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
