@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <h1 id="colorful-text" class="display-4 mb-3 fw-bold">
        Image to Text Art Converter
    </h1>
    <p class="lead">
        Upload an image and convert it into text-based art for terminals, documents, websites, and more.
    </p>
    <p>
        Use the web interface or check out the <a href="/swagger/index.html" target="_blank">netscii API</a>.
    </p>
    <p>
        <a href="#" onclick="openRandomExample()">See Some Examples</a>
    </p>
</div>

<hr class="my-5" />

@section Scripts {
    <script>
        function openRandomExample() {
          const index = Math.floor(Math.random() * 10);
          const url = `/images/${index}.svg`;
          window.open(url, '_blank');
        }
    </script>
}